datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Restaurant {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  tagline         String?
  phone           String?
  address         String?
  city            String?          @default("Delhi NCR")
  ownerName       String?          @default("Partner")
  ownerEmail      String?
  password        String?          @default("admin123")
  staffPin        String?          @default("1234")
  plan            String           @default("starter") // trial, starter, pro, enterprise
  planExpiresAt   DateTime?
  isActive        Boolean          @default(true)
  currency        String           @default("INR")
  currencySymbol  String           @default("₹")
  taxRatePercent  Float            @default(5.0)
  upiId           String?
  logoUrl         String?
  categories      Category[]
  menuItems       MenuItem[]
  tables          Table[]
  orders          Order[]
  serviceRequests ServiceRequest[]
  staff           Staff[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model PlatformSetting {
  id               String   @id @default("global")
  broadcastMessage String?
  isMaintenance    Boolean  @default(false)
  supportPhone     String?  @default("+91 98765 43210")
  updatedAt        DateTime @updatedAt
}

model Category {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  icon         String     @default("🍽️")
  sortOrder    Int        @default(0)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems    MenuItem[]
}

model MenuItem {
  id              String      @id @default(cuid())
  restaurantId    String
  categoryId      String
  name            String
  description     String?
  price           Float
  isVeg           Boolean     @default(true)
  isAvailable     Boolean     @default(true)
  isBestseller    Boolean     @default(false)
  spiceLevel      Int         @default(0)
  prepTimeMinutes Int         @default(10)
  imageUrl        String?
  stockCount      Int?        @default(-1) // -1 = unlimited portions, >=0 = remaining portions
  lowStockThreshold Int?      @default(5)  // alert threshold when stockCount <= lowStockThreshold
  variants        Json?       // Portion sizes e.g. [{"id":"v1","name":"Half Plate","price":180},{"id":"v2","name":"Full Plate","price":320}]
  addons          Json?       // Custom add-ons e.g. [{"id":"a1","name":"Extra Cheese","price":40}]
  restaurant      Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category        Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]
}

model Table {
  id              String           @id @default(cuid())
  restaurantId    String
  tableNumber     String
  seats           Int              @default(4)
  restaurant      Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders          Order[]
  serviceRequests ServiceRequest[]
}

model Order {
  id             String          @id @default(cuid())
  restaurantId   String
  tableId        String
  tableNumber    String
  customerName   String?
  customerPhone  String?
  subtotal       Float
  tax            Float
  discount       Float           @default(0.0)
  couponCode     String?
  rating         Int?
  reviewFeedback String?
  total          Float
  status         String          @default("pending") // pending, cooking, ready, served, completed, cancelled
  paymentMethod  String          @default("counter_cash")
  paymentStatus  String          @default("unpaid")
  restaurant     Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table          Table           @relation(fields: [tableId], references: [id], onDelete: Cascade)
  items          OrderItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  menuItemId     String
  name           String
  price          Float
  quantity       Int
  isVeg          Boolean  @default(true)
  notes          String?
  variantName    String?  // e.g. "Half Plate"
  selectedAddons Json?    // e.g. [{"name":"Extra Cheese","price":40}]
  orderedByName  String?  // e.g. "Aakash", "Rahul"
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem       MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
}

model TableCart {
  id           String          @id @default(cuid())
  restaurantId String
  tableId      String          @unique
  tableNumber  String
  diners       TableDiner[]
  items        TableCartItem[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model TableDiner {
  id        String    @id @default(cuid())
  cartId    String
  dinerId   String
  name      String
  joinedAt  DateTime  @default(now())
  cart      TableCart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, dinerId])
}

model TableCartItem {
  id             String    @id @default(cuid())
  cartId         String
  menuItemId     String
  name           String
  price          Float
  quantity       Int       @default(1)
  isVeg          Boolean   @default(true)
  notes          String?
  variantName    String?
  selectedAddons Json?
  dinerId        String
  dinerName      String
  cart           TableCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model ServiceRequest {
  id           String     @id @default(cuid())
  restaurantId String
  tableId      String
  tableNumber  String
  type         String     // water, waiter, bill, cleaning
  status       String     @default("pending") // pending, attended
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table        Table      @relation(fields: [tableId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
}

model Staff {
  id                String     @id @default(cuid())
  restaurantId      String
  name              String
  role              String     // chef, waiter, cashier, manager
  pin               String     // 4-digit PIN for quick login
  phone             String?
  isActive          Boolean    @default(true)
  canManageOrders   Boolean    @default(true)
  canManageMenu     Boolean    @default(false)
  canManageBilling  Boolean    @default(false)
  canManageRequests Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}
